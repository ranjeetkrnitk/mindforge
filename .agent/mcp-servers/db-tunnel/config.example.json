{
  "environments": {
    "dev": {
      "label": "Development",
      "type": "ssh-tunnel",
      "ssh": {
        "host": "dev-jump.example.com",
        "port": 22,
        "user": "your-ssh-user",
        "auth": "password"
      },
      "db": {
        "type": "postgresql",
        "host": "127.0.0.1",
        "port": 5432,
        "database": "dev_db",
        "user": "db_user"
      }
    },
    "semi": {
      "label": "Semi-Production",
      "type": "ssh-tunnel",
      "ssh": {
        "host": "semi-jump.example.com",
        "port": 22,
        "user": "your-ssh-user",
        "auth": "password"
      },
      "db": {
        "type": "postgresql",
        "host": "127.0.0.1",
        "port": 5432,
        "database": "semi_db",
        "user": "db_user"
      }
    },
    "prod": {
      "label": "Production",
      "type": "ssh-tunnel",
      "ssh": {
        "host": "prod-jump.example.com",
        "port": 22,
        "user": "your-ssh-user",
        "auth": "totp"
      },
      "db": {
        "type": "mysql",
        "host": "127.0.0.1",
        "port": 3306,
        "database": "prod_db",
        "user": "db_user"
      }
    },
    "local": {
      "label": "Local",
      "type": "direct",
      "db": {
        "type": "postgresql",
        "host": "127.0.0.1",
        "port": 5432,
        "database": "local_db",
        "user": "postgres"
      }
    }
  },
  "defaults": {
    "queryRowLimit": 500,
    "tunnelLocalPortStart": 15432,
    "connectTimeoutMs": 15000
  }
}
