{
  "_comment": "Copy this to config.json and fill in your values. NEVER commit config.json.",
  "_ssh_tunnel_note": "For ssh-tunnel envs: ssh.host is the bastion you SSH into. db.host is the DB hostname AS SEEN FROM the bastion (not localhost). This mirrors: ssh -L <localPort>:<db.host>:<db.port> <ssh.user>@<ssh.host>",
  "environments": {
    "dev": {
      "label": "Development",
      "type": "ssh-tunnel",
      "ssh": {
        "host": "bastion.dev.example.com",
        "port": 22,
        "user": "your-ssh-user",
        "auth": "password"
      },
      "db": {
        "type": "postgresql",
        "_host_note": "The DB hostname reachable FROM the bastion, not from your machine",
        "host": "db-primary.dev.internal.example.com",
        "port": 5432,
        "database": "dev_db",
        "user": "db_user"
      }
    },
    "semi": {
      "label": "Semi-Production",
      "type": "ssh-tunnel",
      "ssh": {
        "host": "bastion.semi.example.com",
        "port": 22,
        "user": "your-ssh-user",
        "auth": "password"
      },
      "db": {
        "type": "mysql",
        "_host_note": "The DB hostname reachable FROM the bastion, not from your machine",
        "host": "db-trnx-write.semi.example.com",
        "port": 3306,
        "database": "semi_db",
        "user": "db_user"
      }
    },
    "prod": {
      "label": "Production",
      "type": "ssh-tunnel",
      "ssh": {
        "host": "bastion.prod.example.com",
        "port": 22,
        "user": "your-ssh-user",
        "auth": "totp"
      },
      "db": {
        "type": "mysql",
        "_host_note": "The DB hostname reachable FROM the bastion, not from your machine",
        "host": "db-trnx-write.prod.example.com",
        "port": 3306,
        "database": "prod_db",
        "user": "db_user"
      }
    },
    "local": {
      "label": "Local",
      "type": "direct",
      "db": {
        "type": "postgresql",
        "host": "127.0.0.1",
        "port": 5432,
        "database": "local_db",
        "user": "postgres"
      }
    }
  },
  "defaults": {
    "queryRowLimit": 500,
    "tunnelLocalPortStart": 15432,
    "connectTimeoutMs": 15000
  }
}
