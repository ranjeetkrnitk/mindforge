{
  "name": "mcp-db-tunnel",
  "version": "0.1.0",
  "description": "MCP server for querying databases via SSH tunnels (DEV/SEMI/PROD) or direct connections",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "_nodeNote": "Requires Node 18+. On Apple Silicon with Rosetta shell, run: arch -arm64 node dist/index.js",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "mysql2": "^3.11.5",
    "otplib": "^12.0.1",
    "pg": "^8.13.3",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
